[Unit]
Description=Rebuild dashboard call-chain models (silver_calls_unified + gold)
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/trustwarehouse
EnvironmentFile=/home/ubuntu/trustwarehouse/.env
ExecStart=/home/ubuntu/trustwarehouse/scripts/sync-and-build.sh gold_calls
StandardOutput=journal
StandardError=journal

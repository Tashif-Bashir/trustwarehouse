[Unit]
Description=Google Ads API -> BigQuery bronze sync (8 times per day)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/trustwarehouse
ExecStart=/home/ubuntu/trustwarehouse/scripts/sync-and-build.sh google_ads
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

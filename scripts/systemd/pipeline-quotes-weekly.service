[Unit]
Description=Pipeline quotes workbook (30/60/90 unsold pipeline + Unleashed quotes) -> owner's OneDrive, in place
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/trustwarehouse
EnvironmentFile=/home/ubuntu/trustwarehouse/.env
ExecStart=/home/ubuntu/.local/bin/uv run python -m scripts.pipeline_quotes_weekly
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
